[configuration]
entry_symbol = "godot_terminal_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
macos.debug.arm64 = "res://addons/godot_terminal/bin/libgodot_terminal.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://addons/godot_terminal/bin/libgodot_terminal.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "res://addons/godot_terminal/bin/libgodot_terminal.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://addons/godot_terminal/bin/libgodot_terminal.macos.template_release.x86_64.dylib"
windows.debug.x86_64 = "res://addons/godot_terminal/bin/libgodot_terminal.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/godot_terminal/bin/libgodot_terminal.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://addons/godot_terminal/bin/libgodot_terminal.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://addons/godot_terminal/bin/libgodot_terminal.windows.template_release.arm64.dll"
linux.debug.x86_64 = "res://addons/godot_terminal/bin/libgodot_terminal.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/godot_terminal/bin/libgodot_terminal.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/godot_terminal/bin/libgodot_terminal.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/godot_terminal/bin/libgodot_terminal.linux.template_release.arm64.so"
